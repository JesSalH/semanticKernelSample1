using Microsoft.Extensions.Configuration;
using System.Text.Json;

public class ApiAlphaPlugin
{
    private readonly IConfiguration _configuration;
    private readonly HttpClient _httpClient;
    
    public ApiAlphaPlugin(IConfiguration configuration, HttpClient httpClient)
    {
        _configuration = configuration;
        _httpClient = httpClient;
        
        // Set the base address from configuration
        var baseUrl = _configuration["ApiAlpha:BaseUrl"] ?? "http://localhost:5163";
        _httpClient.BaseAddress = new Uri(baseUrl);
    }
    
    public string ApiAlphaBaseUrl => _configuration["ApiAlpha:BaseUrl"] ?? "http://localhost:5163";

    public async Task<T?> GetAsync<T>(string endpoint, CancellationToken cancellationToken = default)
    {
        var response = await _httpClient.GetAsync(endpoint, cancellationToken);
        try
        {
            response.EnsureSuccessStatusCode();
        }
        catch (HttpRequestException ex)
        {
            throw new Exception($"Error fetching data from {ApiAlphaBaseUrl}/{endpoint}: {ex.Message}", ex);
        }
        var model = await response.Content.ReadFromJsonAsync<T>(cancellationToken: cancellationToken);
        return model;
    }

    public async Task<List<string>?> GetBaseCharacterNames(int id, CancellationToken cancellationToken = default)
    {
        return await GetAsync<List<string>>($"test/{id}", cancellationToken);
    }


}